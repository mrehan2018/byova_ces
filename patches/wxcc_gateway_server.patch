+    _CVP_DROPPED_EVENTS = {"START_OF_INPUT", "END_OF_INPUT"}
+
+    def _cvp_coalesce(
+        self,
+        connector_response: Dict[str, Any],
+        response_type: Optional[int] = None,
+    ) -> Optional[Dict[str, Any]]:
+        """Reshape streaming-connector output for CVP/VVB.
+
+        - drop gateway START_OF_INPUT / END_OF_INPUT event responses (VVB never had them)
+        - buffer CHUNK audio, then attach it as one WAV prompt to the turn's FINAL
+        Returns None when the response is held back or dropped.
+        """
+        resp = dict(connector_response)
+        events = [e for e in (resp.get("output_events") or [])
+                  if e.get("event_type") not in self._CVP_DROPPED_EVENTS]
+        dropped = len(events) != len(resp.get("output_events") or [])
+        resp["output_events"] = events
+
+        is_chunk = (resp.get("response_type") == "chunk"
+                    or response_type == VoiceVAResponse.ResponseType.CHUNK)
+        audio = resp.get("audio_content") or b""
+
+        if is_chunk:
+            if audio:
+                raw = audio[58:] if audio[:4] == b"RIFF" else audio
+                self._cvp_audio_buf.extend(raw)
+                if self._cvp_audio_barge_in is None:
+                    self._cvp_audio_barge_in = bool(resp.get("barge_in_enabled", False))
+            return None          # held until the turn's FINAL
+
+        if dropped and not events and not audio and not resp.get("text") \
+                and resp.get("message_type") in (None, "", "silence"):
+            return None          # pure speech-boundary event response
+
+        if self._cvp_audio_buf:
+            if audio and audio[:4] != b"RIFF":
+                self._cvp_audio_buf.extend(audio)
+            resp["audio_content"] = self._mulaw_wav(bytes(self._cvp_audio_buf))
+            if resp.get("message_type") in (None, "", "silence"):
+                resp["message_type"] = "audio"
+            resp.setdefault("text", "")
+            if self._cvp_audio_barge_in is not None:
+                resp["barge_in_enabled"] = self._cvp_audio_barge_in
+            self.logger.info(
+                "[CVP] Coalesced streamed audio into one WAV prompt for %s (%d bytes, ~%.1fs)",
+                self.conversation_id, len(self._cvp_audio_buf), len(self._cvp_audio_buf) / 8000.0,
+            )
+            self._cvp_audio_buf = bytearray()
+            self._cvp_audio_barge_in = None
+        # VVB stops collecting caller audio after a prompt with barge-in disabled
+        # (never starts the next input stream). Every prompt VVB handled turn after
+        # turn (Dialogflow CX, barge_in_enabled=True by default) had barge-in on, so
+        # in CVP mode non-terminal prompts are always sent bargeable.
+        if resp.get("audio_content") and resp.get("message_type") not in ("goodbye", "transfer", "session_end"):
+            if not resp.get("barge_in_enabled", False):
+                self.logger.info("[CVP] Prompt for %s sent with barge-in enabled (VVB needs it to keep "
+                                 "collecting caller audio)", self.conversation_id)
+            resp["barge_in_enabled"] = True
+        resp["response_type"] = "final"
+        return resp
+
+    @staticmethod
+    def _mulaw_wav(audio: bytes) -> bytes:
+        """8 kHz MULAW → WAV in the layout Dialogflow CX returns (fmt type 7 + fact), which VVB plays."""
+        import struct as _struct
+        n = len(audio)
+        fmt = _struct.pack("<HHIIHHH", 7, 1, 8000, 8000, 1, 8, 0)
+        body = (b"WAVE" + b"fmt " + _struct.pack("<I", len(fmt)) + fmt
+                + b"fact" + _struct.pack("<II", 4, n)
+                + b"data" + _struct.pack("<I", n) + audio + (b"\x00" if n % 2 else b""))
+        return b"RIFF" + _struct.pack("<I", len(body)) + body
+
